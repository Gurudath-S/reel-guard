<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/limit_reached" android:textColor="#FFFFFF" android:textSize="28sp" />
        <TextView android:id="@+id/block_reason" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:gravity="center" android:textColor="#D3E4DA"
            android:textSize="16sp" android:layout_marginTop="12dp" />
        <Button android:id="@+id/close_app" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/close_app" />
    </LinearLayout>
</ScrollView>
